<mujoco model="panda scene">

  <!-- <option cone="elliptic" impratio="100"/> -->

  <size nconmax="500" njmax="2000"/>
  <include file="panda.xml"/>
  <!-- <option timestep="1e-3"/> -->

  <option timestep="1e-3" 
    cone="elliptic" 
    impratio="5"
    tolerance="1e-6"
    iterations="30"
    ls_iterations="10"
    noslip_tolerance="1e-6">
  </option>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.22 0.22 0.22" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>
  <!-- <option timestep="0.0001">
    <flag eulerdamp="disable" contact="enable" gravity="enable"/>
  </option> -->

  <option noslip_iterations="3">
    <flag multiccd="enable"  gravity="enable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0.3 -0.5 -1" diffuse="0.62 0.62 0.62" specular="0.2 0.2 0.2" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
    <!-- <camera name="front_cam" pos="-0.7545 -1.5888 1.0762"
            xyaxes="0.866 -0.5 0 0.211 0.366 0.906" fovy="45" mode="fixed"/> -->
    <camera name="front_cam" pos="-0.65 -1.3 1.0762"
            xyaxes="0.866 -0.5 0 0.211 0.366 0.906" fovy="45" mode="fixed"/>
    <camera name="topdown_cam" pos="0 -0.345 1.05"
            xyaxes="1 0 0 0 1 0" fovy="45" mode="fixed"/>

    <!-- First Row -->
      <body name="obstacle_soft1" pos="-0.2 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft1_joint" type="free"/>
        <geom name="obstacle_soft1_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle_soft2" pos="-0.1 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft2_joint" type="free"/>
        <geom name="obstacle_soft2_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle_soft3" pos="0.0 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft3_joint" type="free"/>
        <geom name="obstacle_soft3_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle_soft4" pos="0.1 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft4_joint" type="free"/>
        <geom name="obstacle_soft4_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="object3" pos="0.2 -0.25 0.43" quat="0 0 0 1">
        <joint name="object3_joint" type="free"/>
        <geom name="object3_geom" type="box" size="0.03 0.03 0.03" rgba="0.0 0.35 0.0 1" solimp="0.015 1 0.02" solref="0.005 1" condim="6" friction="2.8 1.2 0.1"/>
      </body>

    <!-- Second Row -->
      <body name="obstacle_soft5" pos="-0.2 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft5_joint" type="free"/>
        <geom name="obstacle_soft5_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle_hard6" pos="-0.1 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle_hard6_joint" type="free"/>
        <geom name="obstacle_hard6_geom" type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle_soft7" pos="0.0 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft7_joint" type="free"/>
        <geom name="obstacle_soft7_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle_soft8" pos="0.1 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft8_joint" type="free"/>
        <geom name="obstacle_soft8_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle_soft9" pos="0.2 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle_soft9_joint" type="free"/>
        <geom name="obstacle_soft9_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

    <!-- Third Row -->
      <body name="object1" pos="-0.2 -0.45 0.43" quat="0 0 0 1">
        <joint name="object1_joint" type="free"/>
        <geom name="object1_geom" type="box" size="0.03 0.03 0.03" rgba="0.0 0.0 0.35 1"/>
      </body>

      <body name="obstacle_hard10" pos="-0.1 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle_hard10_joint" type="free"/>
        <geom name="obstacle_hard10_geom" type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle_hard11" pos="0.0 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle_hard11_joint" type="free"/>
        <geom name="obstacle_hard11_geom" type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle_hard12" pos="0.1 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle_hard12_joint" type="free"/>
        <geom name="obstacle_hard12_geom" type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle_hard13" pos="0.2 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle_hard13_joint" type="free"/>
        <geom name="obstacle_hard13_geom" type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

    <!-- simple table, now really on the ground -->
    <body name="simple_table" pos="0 -0.35 0" quat="0 0 0 1">
      <joint name="table_joint" type="free"/>

      <!-- tabletop -->
      <geom type="box" size="0.30 0.16 0.02" pos="0 0 0.38"
            rgba="0.35 0.35 0.35 1"/>

      <!-- legs -->
      <geom type="box" size="0.015 0.015 0.18" pos=" 0.28  0.14 0.18"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.18" pos="-0.28  0.14 0.18"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.18" pos=" 0.28 -0.14 0.18"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.18" pos="-0.28 -0.14 0.18"
            rgba="0.3 0.3 0.3 1"/> 

      <!-- picking sites (mid-thickness)
      <site name="site_right" pos="-0.20 0 0.25" size="0.005"
            rgba="1 0 0 1"  type="sphere" euler="-1.57 1.57 0"/>
      <site name="site_left"  pos=" 0.20 0 0.25" size="0.005"
            rgba="0 1 0 1"  type="sphere" euler="-1.57 -1.57 0"/> -->
            
    </body>

  </worldbody>
</mujoco>
