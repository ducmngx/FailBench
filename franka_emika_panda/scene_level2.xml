<mujoco model="panda scene">

  <!-- <option cone="elliptic" impratio="100"/> -->

  <size nconmax="500" njmax="2000"/>
  <include file="panda.xml"/>
  <!-- <option timestep="1e-3"/> -->

  <option timestep="1e-3" 
    cone="elliptic" 
    impratio="5"
    tolerance="1e-6"
    iterations="30"
    ls_iterations="10"
    noslip_tolerance="1e-6">
  </option>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>
  <!-- <option timestep="0.0001">
    <flag eulerdamp="disable" contact="enable" gravity="enable"/>
  </option> -->

  <option noslip_iterations="3">
    <flag multiccd="enable"  gravity="enable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>


    <!-- First Row -->
      <body name="obstacle1" pos="-0.2 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle1_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle2" pos="-0.1 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle2_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle3" pos="0.0 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle3_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle4" pos="0.1 -0.25 0.43" quat="0 0 0 1">
        <joint name="obstacle4_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="object3" pos="0.2 -0.25 0.43" quat="0 0 0 1">
        <joint name="object3_joint" type="free"/>
        <geom name="object3_geom" type="box" size="0.03 0.03 0.03" rgba="0.0 0.35 0.0 1" solimp="0.015 1 0.02" solref="0.005 1" condim="6" friction="2.8 1.2 0.1"/>
      </body>

    <!-- Second Row -->
      <body name="obstacle5" pos="-0.2 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle5_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle6" pos="-0.1 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle6_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle7" pos="0.0 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle7_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle8" pos="0.1 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle8_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

      <body name="obstacle9" pos="0.2 -0.35 0.43" quat="0 0 0 1">
        <joint name="obstacle9_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
      </body>

    <!-- Third Row -->
      <body name="object1" pos="-0.2 -0.45 0.43" quat="0 0 0 1">
        <joint name="object1_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="0.0 0.0 0.35 1"/>
      </body>

      <body name="obstacle10" pos="-0.1 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle10_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle11" pos="0.0 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle11_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle12" pos="0.1 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle12_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

      <body name="obstacle13" pos="0.2 -0.45 0.43" quat="0 0 0 1">
        <joint name="obstacle13_joint" type="free"/>
        <geom type="box" size="0.03 0.03 0.03" rgba="0.4 0.0 0.0 1"/>
      </body>

    <!-- simple table, now really on the ground -->
    <body name="simple_table" pos="0 -0.35 0" quat="0 0 0 1">
      <joint name="table_joint" type="free"/>

      <!-- tabletop -->
      <geom type="box" size="0.30 0.16 0.02" pos="0 0 0.38"
            rgba="0.35 0.35 0.35 1"/>

      <!-- legs -->
      <geom type="box" size="0.015 0.015 0.18" pos=" 0.28  0.14 0.18"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.18" pos="-0.28  0.14 0.18"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.18" pos=" 0.28 -0.14 0.18"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.18" pos="-0.28 -0.14 0.18"
            rgba="0.3 0.3 0.3 1"/> 

      <!-- picking sites (mid-thickness)
      <site name="site_right" pos="-0.20 0 0.25" size="0.005"
            rgba="1 0 0 1"  type="sphere" euler="-1.57 1.57 0"/>
      <site name="site_left"  pos=" 0.20 0 0.25" size="0.005"
            rgba="0 1 0 1"  type="sphere" euler="-1.57 -1.57 0"/> -->
            
    </body>

  </worldbody>
</mujoco>
