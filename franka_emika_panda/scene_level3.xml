<mujoco model="panda scene">

  <!-- <option cone="elliptic" impratio="100"/> -->

  <size nconmax="500" njmax="2000"/>
  <include file="panda.xml"/>
  <!-- <option timestep="1e-3"/> -->

  <option timestep="1e-3" 
    cone="elliptic" 
    impratio="5"
    tolerance="1e-6"
    iterations="30"
    ls_iterations="10"
    noslip_tolerance="1e-6">
  </option>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>
  <!-- <option timestep="0.0001">
    <flag eulerdamp="disable" contact="enable" gravity="enable"/>
  </option> -->

  <option noslip_iterations="3">
    <flag multiccd="enable"  gravity="enable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- HIGH FRICTION MATERIALS FOR GRASPING -->
    <!-- <material name="high_friction" rgba="0.0 0.35 0.0 1" friction="2.0 0.5 0.1"/>
    <material name="gripper_friction" rgba="0.3 0.3 0.3 1" friction="2.5 0.5 0.1"/> -->
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- mocap targets (unchanged) -->
    <!-- <body name="target_left"  pos="0.1 0 0.5" quat="0 0 0 1" mocap="true">
      <geom type="box" size="0.05 0.05 0.05" contype="0" conaffinity="0"
            rgba="0.6 0.3 0.3 0.0"/>
    </body>
    <body name="target_right" pos="0.1 0 0.5" quat="0 0 0 1" mocap="true">
      <geom type="box" size="0.05 0.05 0.05" contype="0" conaffinity="0"
            rgba="0.6 0.3 0.3 0.0"/>
    </body> -->


    <!-- Add some object to it -->

  <!-- Lower objects -->
    <body name="object1" pos="-0.15 -0.4 0.305" quat="0 0 0 1">
      <joint name="object1_joint" type="free"/>
      <geom name="object1_geom" type="box" size="0.03 0.03 0.03" rgba="0.0 0.0 0.35 1"/>
    </body>

    <body name="obstacle_hard1" pos="0.0 -0.4 0.38" quat="0 0 0 1">
      <joint name="obstacle_hard1_joint" type="free"/>
      <geom name="obstacle_hard1_geom" type="box" size="0.03 0.03 0.12" rgba="0.35 0.0 0.0 1"/>
    </body>

    <body name="obstacle_hard2" pos="-0.07 -0.33 0.305" quat="0 0 0 1">
      <joint name="obstacle_hard2_joint" type="free"/>
      <geom name="obstacle_hard2_geom" type="box" size="0.03 0.03 0.03" rgba="0.35 0.0 0.0 1"/>
    </body>

    <body name="obstacle_hard3" pos="0.07 -0.33 0.305" quat="0 0 0 1">
      <joint name="obstacle_hard3_joint" type="free"/>
      <geom name="obstacle_hard3_geom" type="box" size="0.03 0.03 0.03" rgba="0.35 0.0 0.0 1"/>
    </body>

    <body name="obstacle_soft1" pos="-0.07 -0.47 0.305" quat="0 0 0 1">
      <joint name="obstacle_soft1_joint" type="free"/>
      <geom name="obstacle_soft1_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
    </body>

    <body name="obstacle_soft2" pos="0.07 -0.47 0.305" quat="0 0 0 1">
      <joint name="obstacle_soft2_joint" type="free"/>
      <geom name="obstacle_soft2_geom" type="box" size="0.03 0.03 0.03" rgba="1.0 1.0 0.698 1"/>
    </body>

    <body name="object3" pos="0.16 -0.4 0.305" quat="0 0 0 1">
      <joint name="object3_joint" type="free"/>
      <geom name="object3_geom" type="box" size="0.03 0.03 0.03" rgba="0.0 0.35 0.0 1" solimp="0.015 1 0.02" solref="0.005 1" condim="6" friction="2.8 1.2 0.1"/>
    </body>

    <!-- simple table, now really on the ground -->
    <body name="simple_table" pos="0 -0.4 0" quat="0 0 0 1">
      <joint name="table_joint" type="free"/>

      <!-- tabletop -->
      <!-- <geom type="box" size="0.20 0.13 0.01" pos="0 0 0.25"
            rgba="0.35 0.35 0.35 1"/> -->
      <geom type="box" size="0.20 0.13 0.02" pos="0 0 0.25"
            rgba="0.35 0.35 0.35 1"/>

      <!-- legs -->
      <geom type="box" size="0.015 0.015 0.125" pos=" 0.18  0.11 0.125"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.125" pos="-0.18  0.11 0.125"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.125" pos=" 0.18 -0.11 0.125"
            rgba="0.3 0.3 0.3 1"/>
      <geom type="box" size="0.015 0.015 0.125" pos="-0.18 -0.11 0.125"
            rgba="0.3 0.3 0.3 1"/>
            
    </body>

  </worldbody>
</mujoco>



