/archive
CLAUDE.md

__pycache__/
.DS_STORE

MUJOCO_LOG.TXT


.env
.vscode/
.claude/

# External assets (cloned repos — download via external_assets/setup.sh)
external_assets/vikashplus_*/
external_assets/kevinzakka_*/

# GraspGen submodule — ignore venv and checkpoints (installed via scripts/install_graspgen.sh)
external/GraspGen/.venv/
external/GraspGen/checkpoints/
external/GraspGen/**/*.egg-info/
external/GraspGen/**/__pycache__/

# LIBERO sidecar — ignore venv, in-tree datasets, and __pycache__ (installed via
# external/LIBERO/.venv; datasets fetched via scripts/libero/download_libero.py)
external/LIBERO/.venv/
external/LIBERO/datasets/
external/LIBERO/**/*.egg-info/
external/LIBERO/**/__pycache__/

# RoboCasa sidecars — entire clone trees (mimicdroid-robocasa + ShahRutav/robosuite,
# assets downloaded via robocasa/scripts/download_kitchen_assets, ~21 GB).
external/robocasa/
external/robosuite_for_robocasa/

# GraspGen precomputed grasps — regenerate via scripts/precompute_grasps.py
cache/graspgen/

# Generated datasets (failure-injection output) — regenerate via test_pipeline.py
# or scripts/generate_dataset_tasks.py
scenes/*/datasets/
/datasets/

# Heatmap regressor training outputs — regenerate via scripts/train_demo.py
/runs/

# Local artefacts: rendered videos, debug previews, and grasp/MJCF caches.
# Regenerate via the relevant scripts/notebooks.
/out/
/cache/

# HuggingFace release tree — derived artifact built by scripts/data/build_hf_release.py.
# Contains symlinks into /media/aaron/F that won't survive a git clone.
/hf_release/

# Training-run stdout logs (the run dirs in /runs/ already contain metrics.csv
# and best.pt; these are just tee'd stdout copies).
/logs/
